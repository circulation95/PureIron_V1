# deploy/central compose 변수(M4-3). 복사해 deploy/central/.env(커밋 안 됨)로 두거나 --env-file로 넘긴다.
# 비밀값은 여기에 쓰지 않는다 — 아래 디렉터리의 파일로만(README.md "비밀 파일").

# 중앙 이미지 태그 = release 이름(build_images.sh의 PUREIRON_RELEASE, 기록은 deploy/releases/central/<이름>.json)
PUREIRON_CENTRAL_RELEASE=0.1.0-dev
# 비밀 파일 디렉터리(저장소 밖, 0700 권장): control_db_password · viewer_token · ui_basic_auth
PUREIRON_CENTRAL_SECRETS_DIR=/home/CHANGE-ME/pureiron-central/secrets
# 인증서 이름(Caddy tls internal). 여러 개면 쉼표: localhost, 192.168.0.10
PUREIRON_CENTRAL_HOST=localhost
# 바깥에 여는 HTTPS 포트 하나(Caddy). 현장 VM이 붙으려면 BIND=0.0.0.0(방화벽은 따로).
# 사용 중인 포트와 겹치지 않게: 25432·25433(CI DB), 25443·8100(M4-2 리허설), 28543(control-web e2e).
PUREIRON_CENTRAL_BIND=127.0.0.1
PUREIRON_CENTRAL_HTTPS_PORT=28443
# 현장 poll 주기(초). online = 마지막 수신 ≤ 3 × 이 값(C8). 현장 Updater poll 주기와 맞춘다.
PUREIRON_CONTROL_POLL_S=60
