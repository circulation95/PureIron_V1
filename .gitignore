# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
/dist/
services/*/dist/
/build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/

# Environment / secrets
.env
.env.*
!.env.example
# 개인키(번들 서명 seed 포함)는 어디에도 커밋하지 않는다. PEM은 TLS 개인키일 수 있어 막되,
# deploy/keys/의 공개키 PEM(root.pem 등, 공개 정보)만 예외로 둔다.
*.key
*.seed
*.pem
!deploy/keys/*.pem

# Local agent/tool state
.omc/
.moai/
.claude/settings.local.json

# 리뷰 증거 스크린샷은 커밋하지 않는다 (agent-rules `작업 증거 규율`)
docs/pr-evidence/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# 로컬 도구 바이너리(scripts/tools.sh가 버전·sha256 고정으로 설치)
.tools/
# 빌드·게이트 산출물
artifacts/
out/
