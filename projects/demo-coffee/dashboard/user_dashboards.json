{
  "admin": {
    "version": 1,
    "widgets": [
      {
        "id": "coffee-tank1-level",
        "type": "tag-gauge",
        "title": "Extraction Tank 1 Level",
        "config": {
          "tagPath": "[modbus_test]CoffeeTank/Tank1/level",
          "min": 0,
          "max": 100,
          "unit": "%"
        }
      },
      {
        "id": "coffee-tank1-temperature",
        "type": "tag-value",
        "title": "Extraction Tank 1 Temperature",
        "config": {
          "tagPath": "[modbus_test]CoffeeTank/Tank1/temperature",
          "unit": "°C",
          "precision": 1
        }
      },
      {
        "id": "coffee-pmp101-flow",
        "type": "tag-value",
        "title": "PMP101 Transfer Flow",
        "config": {
          "tagPath": "[modbus_test]CoffeeTank/Pumps/PMP101/Flow",
          "unit": "L/min",
          "precision": 1
        }
      },
      {
        "id": "coffee-pmp101-pressure",
        "type": "tag-value",
        "title": "PMP101 Discharge Pressure",
        "config": {
          "tagPath": "[modbus_test]CoffeeTank/Pumps/PMP101/Pressure",
          "unit": "bar",
          "precision": 1
        }
      },
      {
        "id": "coffee-extraction-alarms",
        "type": "alarm-summary",
        "title": "Coffee Extraction Alarms",
        "config": {}
      },
      {
        "id": "coffee-extraction-trend",
        "type": "trend",
        "title": "Coffee Extraction Trend",
        "config": {
          "tagPaths": [
            "[modbus_test]CoffeeTank/Tank1/level",
            "[modbus_test]CoffeeTank/Tank1/temperature",
            "[modbus_test]CoffeeTank/Pumps/PMP101/Flow",
            "[modbus_test]CoffeeTank/Pumps/PMP101/Pressure"
          ],
          "rangeMinutes": 60
        }
      },
      {
        "id": "coffee-hmi-link",
        "type": "process-link",
        "title": "Open Coffee Extraction HMI",
        "config": {
          "path": "/process/extraction",
          "label": "Coffee Extraction HMI"
        }
      }
    ],
