  "info": {
    "title": "PureIron control-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/bundles/{site}/{generation}": {
      "put": {
        "operationId": "publish_bundle",
        "parameters": [
          {
            "description": "현장 id",
            "in": "path",
            "name": "site",
            "required": true,
            "schema": {
              "description": "현장 id",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Site",
              "type": "string"
            }
          },
          {
            "description": "번들 generation(PD-15)",
            "in": "path",
            "name": "generation",
            "required": true,
            "schema": {
              "description": "번들 generation(PD-15)",
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Generation",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "description": "서명된 현장 번들 `.pib`",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "`.pib`가 아니거나 manifest site·gen이 경로와 다름"
          },
          "404": {
            "description": "미등록 현장"
          },
          "409": {
            "description": "gen ≤ 최신 게시"
          },
          "413": {
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "507": {
            "description": "데이터 디렉터리 쓰기 실패"
          }
        },
        "security": [
          {
            "ControlToken": []
          }
        ],
        "summary": "Publish",
        "tags": [
          "bundles"
        ]
      }
    },
    "/api/v1/fleet": {
      "get": {
        "operationId": "get_fleet",
        "parameters": [
          {
            "in": "query",
            "name": "site",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Site"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FleetSite"
                  },
                  "title": "Response Get Fleet",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "미등록 현장"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ControlToken": []
          }
        ],
        "summary": "Get Fleet",
        "tags": [
          "fleet"
        ]
      }
    },
    "/api/v1/healthz": {
      "get": {
        "operationId": "control_healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/offline-imports": {
      "post": {
        "operationId": "import_offline_reports",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "purpose `site-reports` 봉투. 현장 site key 서명 봉투(`pureiron_bundle.sitesign`). 서명 대상은 JCS(`{format, payload, purpose}`), 서명은 Ed25519 raw 64B hex.",
                "properties": {
                  "format": {
                    "const": 1
                  },
                  "payload": {
                    "type": "object"
                  },
                  "purpose": {
                    "type": "string"
                  },
                  "signature": {
                    "pattern": "^[0-9a-f]{128}$",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "purpose",
                  "payload",
                  "signature"
                ],
                "title": "SiteSignedEnvelope",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfflineImported"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "등록된 site 키로 서명이 확인되지 않음(현장 재등록 뒤 rekey 대기, 또는 폐기된 구 키로 서명)"
          }
        },
        "security": [
          {
            "ControlToken": []
          }
        ],
        "summary": "Offline Import",
        "tags": [
          "reports"
        ]
      }
    },
    "/api/v1/readyz": {
      "get": {
        "operationId": "control_readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
