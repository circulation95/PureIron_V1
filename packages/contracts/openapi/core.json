{
  "components": {
    "schemas": {
      "Acquisition": {
        "description": "수집 상태 집계(준비 판정에는 쓰지 않음 — 장비가 꺼진 현장도 ready). 태그 값은 담지 않는다.",
        "properties": {
          "devices_connected": {
            "title": "Devices Connected",
            "type": "integer"
          },
          "devices_total": {
            "title": "Devices Total",
            "type": "integer"
          },
          "good_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Good Ratio"
          },
          "plan_rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Rev"
          },
          "tags_good": {
            "title": "Tags Good",
            "type": "integer"
          },
          "tags_total": {
            "title": "Tags Total",
            "type": "integer"
          }
        },
        "required": [
          "plan_rev",
          "devices_total",
          "devices_connected",
          "tags_total",
          "tags_good",
          "good_ratio"
        ],
        "title": "Acquisition",
        "type": "object"
      },
      "Check": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Check",
        "type": "object"
      },
      "EditLockOut": {
        "properties": {
          "site_rev": {
            "title": "Site Rev",
            "type": "integer"
          }
        },
        "required": [
          "site_rev"
        ],
        "title": "EditLockOut",
        "type": "object"
      },
      "EditLockRequest": {
        "properties": {
          "generation": {
            "minimum": 0.0,
            "title": "Generation",
            "type": "integer"
          },
          "owner": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Owner",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "generation"
        ],
        "title": "EditLockRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "ProjectStateOut": {
        "properties": {
          "applied_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applied At"
          },
          "base_site_rev": {
            "title": "Base Site Rev",
            "type": "integer"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "edit_lock_gen": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edit Lock Gen"
          },
          "edit_lock_owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edit Lock Owner"
          },
          "edit_locked": {
            "title": "Edit Locked",
            "type": "boolean"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "site_rev": {
            "title": "Site Rev",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "project_id",
          "version",
          "content_hash",
          "base_site_rev",
          "site_rev",
          "edit_locked",
          "edit_lock_owner",
          "edit_lock_gen",
          "applied_at"
        ],
        "title": "ProjectStateOut",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "acquisition": {
            "$ref": "#/components/schemas/Acquisition"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "checks",
          "acquisition"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "collector": {
            "$ref": "#/components/schemas/Check"
          },
          "db": {
            "$ref": "#/components/schemas/Check"
          },
          "schema_envelope": {
            "$ref": "#/components/schemas/SchemaEnvelopeCheck"
          }
        },
        "required": [
          "db",
          "schema_envelope",
          "collector"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "SchemaEnvelopeCheck": {
        "properties": {
          "app_expected": {
            "title": "App Expected",
            "type": "integer"
          },
          "app_max_compatible": {
            "title": "App Max Compatible",
            "type": "integer"
          },
          "cur": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cur"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "cur",
          "app_expected",
          "app_max_compatible"
        ],
        "title": "SchemaEnvelopeCheck",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Updater token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "PureIron core",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/api/v1/project": {
      "get": {
        "operationId": "get_project",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Project",
        "tags": [
          "project"
        ]
      }
    },
    "/api/v1/project/edit-lock": {
      "delete": {
        "operationId": "release_edit_lock",
        "parameters": [
          {
            "in": "query",
            "name": "owner",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Owner",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "409": {
            "description": "held by another owner"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Release Edit Lock",
        "tags": [
          "project"
        ]
      },
      "post": {
        "operationId": "acquire_edit_lock",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditLockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditLockOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "held by another owner"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Acquire Edit Lock",
        "tags": [
          "project"
        ]
      }
    },
    "/api/v1/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
