{
  "components": {
    "schemas": {
      "Acquisition": {
        "description": "수집 상태 집계(준비 판정에는 쓰지 않음 — 장비가 꺼진 현장도 ready). 태그 값은 담지 않는다.",
        "properties": {
          "devices_connected": {
            "title": "Devices Connected",
            "type": "integer"
          },
          "devices_total": {
            "title": "Devices Total",
            "type": "integer"
          },
          "good_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Good Ratio"
          },
          "ingest": {
            "$ref": "#/components/schemas/IngestCounts"
          },
          "plan_rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Rev"
          },
          "tags_good": {
            "title": "Tags Good",
            "type": "integer"
          },
          "tags_total": {
            "title": "Tags Total",
            "type": "integer"
          }
        },
        "required": [
          "plan_rev",
          "devices_total",
          "devices_connected",
          "tags_total",
          "tags_good",
          "good_ratio",
          "ingest"
        ],
        "title": "Acquisition",
        "type": "object"
      },
      "AuditEntryOut": {
        "properties": {
          "action": {
            "description": "예: auth.login, auth.login_failed, users.add",
            "title": "Action",
            "type": "string"
          },
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "source": {
            "description": "api · cli · updater",
            "title": "Source",
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "time": {
            "format": "date-time",
            "title": "Time",
            "type": "string"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "행위자. Updater·CLI처럼 로그인 사용자가 없으면 null",
            "title": "Username"
          }
        },
        "required": [
          "id",
          "time",
          "username",
          "action",
          "target",
          "detail",
          "source"
        ],
        "title": "AuditEntryOut",
        "type": "object"
      },
      "AuditPage": {
        "properties": {
          "entries": {
            "description": "최신순",
            "items": {
              "$ref": "#/components/schemas/AuditEntryOut"
            },
            "title": "Entries",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "AuditPage",
        "type": "object"
      },
      "Check": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Check",
        "type": "object"
      },
      "EditLockOut": {
        "properties": {
          "site_rev": {
            "title": "Site Rev",
            "type": "integer"
          }
        },
        "required": [
          "site_rev"
        ],
        "title": "EditLockOut",
        "type": "object"
      },
      "EditLockRequest": {
        "properties": {
          "generation": {
            "minimum": 0.0,
            "title": "Generation",
            "type": "integer"
          },
          "owner": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Owner",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "generation"
        ],
        "title": "EditLockRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Historian": {
        "description": "이력 기록 상태(준비 판정에는 쓰지 않음). 누적 값은 core 기동 후 기준.",
        "properties": {
          "buffer_rows": {
            "description": "아직 DB에 쓰지 못한 메모리 버퍼 행 수(쓰는 중 포함)",
            "title": "Buffer Rows",
            "type": "integer"
          },
          "db_ok": {
            "description": "마지막 이력 쓰기 성공 여부",
            "title": "Db Ok",
            "type": "boolean"
          },
          "dropped_total": {
            "description": "버퍼 상한을 넘어 버린(가장 오래된) 행 수",
            "title": "Dropped Total",
            "type": "integer"
          },
          "poisoned_total": {
            "description": "site-db가 행 내용 때문에 거부해 버린 행 수(batch를 반으로 나눠 그 행만 격리)",
            "title": "Poisoned Total",
            "type": "integer"
          },
          "rejected_total": {
            "description": "이력에서 버린 샘플 수 = batch plan_rev가 현재 rev보다 앞선 것(site-db 재생성 신호) + 현재 정의에 없는 tag_id의 live 샘플(정의 기준 — plan에서 문제로 빠진 태그는 기록) + int4 범위 밖 tag_id",
            "title": "Rejected Total",
            "type": "integer"
          },
          "write_lag_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "버퍼에서 가장 오래 기다린 행의 대기 시간",
            "title": "Write Lag S"
          },
          "written_total": {
            "description": "INSERT에 넘긴 행 수(중복으로 무시된 행 포함)",
            "title": "Written Total",
            "type": "integer"
          }
        },
        "required": [
          "buffer_rows",
          "dropped_total",
          "written_total",
          "poisoned_total",
          "write_lag_s",
          "db_ok",
          "rejected_total"
        ],
        "title": "Historian",
        "type": "object"
      },
      "IngestCounts": {
        "description": "ingest 누적 샘플 수(core 기동 후). live만 현재값에 반영, 나머지는 이력 전용.",
        "properties": {
          "batches": {
            "description": "받은 ValueBatch 수(heartbeat 포함)",
            "title": "Batches",
            "type": "integer"
          },
          "future": {
            "title": "Future",
            "type": "integer"
          },
          "heartbeats": {
            "description": "그중 빈 batch(heartbeat) 수",
            "title": "Heartbeats",
            "type": "integer"
          },
          "live": {
            "title": "Live",
            "type": "integer"
          },
          "replay": {
            "title": "Replay",
            "type": "integer"
          },
          "stale": {
            "title": "Stale",
            "type": "integer"
          }
        },
        "required": [
          "live",
          "stale",
          "future",
          "replay",
          "batches",
          "heartbeats"
        ],
        "title": "IngestCounts",
        "type": "object"
      },
      "LoginOut": {
        "properties": {
          "expires_at": {
            "description": "절대 만료 시각(유휴 만료는 더 이를 수 있다)",
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "token": {
            "description": "세션 토큰(쿠키와 같은 값). 비브라우저는 `Authorization: Bearer`로 보낸다",
            "title": "Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/MeOut"
          }
        },
        "required": [
          "token",
          "expires_at",
          "user"
        ],
        "title": "LoginOut",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "role": {
            "$ref": "#/components/schemas/RoleName",
            "description": "권한 수준: viewer < operator < engineer < admin"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "username",
          "role",
          "display_name"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "PasswordChangeRequest": {
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChangeRequest",
        "type": "object"
      },
      "ProjectStateOut": {
        "properties": {
          "applied_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applied At"
          },
          "base_site_rev": {
            "title": "Base Site Rev",
            "type": "integer"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "edit_lock_gen": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edit Lock Gen"
          },
          "edit_lock_owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edit Lock Owner"
          },
          "edit_locked": {
            "title": "Edit Locked",
            "type": "boolean"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "site_rev": {
            "title": "Site Rev",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "project_id",
          "version",
          "content_hash",
          "base_site_rev",
          "site_rev",
          "edit_locked",
          "edit_lock_owner",
          "edit_lock_gen",
          "applied_at"
        ],
        "title": "ProjectStateOut",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "acquisition": {
            "$ref": "#/components/schemas/Acquisition"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "historian": {
            "$ref": "#/components/schemas/Historian"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "checks",
          "acquisition",
          "historian"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "collector": {
            "$ref": "#/components/schemas/Check"
          },
          "db": {
            "$ref": "#/components/schemas/Check"
          },
          "schema_envelope": {
            "$ref": "#/components/schemas/SchemaEnvelopeCheck"
          }
        },
        "required": [
          "db",
          "schema_envelope",
          "collector"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "RoleName": {
        "enum": [
          "viewer",
          "operator",
          "engineer",
          "admin"
        ],
        "type": "string"
      },
      "SchemaEnvelopeCheck": {
        "properties": {
          "app_expected": {
            "title": "App Expected",
            "type": "integer"
          },
          "app_max_compatible": {
            "title": "App Max Compatible",
            "type": "integer"
          },
          "cur": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cur"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "cur",
          "app_expected",
          "app_max_compatible"
        ],
        "title": "SchemaEnvelopeCheck",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionBearer": {
        "description": "로그인 응답 본문의 `token`을 `Authorization: Bearer`로. 비브라우저(ai·스크립트)용",
        "scheme": "bearer",
        "type": "http"
      },
      "SessionCookie": {
        "description": "로그인 응답이 굽는 세션 쿠키(HttpOnly·SameSite=Strict). 브라우저용",
        "in": "cookie",
        "name": "pureiron_session",
        "type": "apiKey"
      },
      "UpdaterToken": {
        "description": "Updater token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "PureIron core",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/audit": {
      "get": {
        "operationId": "list_audit",
        "parameters": [
          {
            "in": "query",
            "name": "username",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Username"
            }
          },
          {
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "description": "포함(>=)",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "포함(>=)",
              "title": "Start"
            }
          },
          {
            "description": "제외(<)",
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "제외(<)",
              "title": "End"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "not authenticated"
          },
          "403": {
            "description": "requires engineer or higher"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "SessionBearer": []
          }
        ],
        "summary": "List Audit",
        "tags": [
          "audit"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "not authenticated"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "not authenticated"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "SessionBearer": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "not authenticated"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "SessionBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "current password is incorrect"
          },
          "401": {
            "description": "not authenticated"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "SessionBearer": []
          }
        ],
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/api/v1/project": {
      "get": {
        "operationId": "get_project",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateOut"
                }
              }
            },
            "description": "Successful Response"
